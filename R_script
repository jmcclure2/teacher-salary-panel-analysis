# ============================================================
# Teacher Salary and State Economic Conditions
# ============================================================
#
# Purpose:
#   Construct a state-year panel combining IPUMS USA microdata
#   with state-level teacher salary and union data, then estimate
#   fixed-effects models of teacher salaries.
#
# Methods:
#   - Secondary data processing
#   - Weighted survey-data aggregation
#   - Data cleaning and transformation
#   - Dataset reshaping and merging
#   - Inflation adjustment
#   - Panel-data construction
#   - Fixed-effects regression
#   - Cluster-robust standard errors
#   - Data quality checks
#
# Author: Jack McClure
# ============================================================


# ------------------------------------------------------------
# 1. Load packages
# ------------------------------------------------------------

library(dplyr)
library(tidyr)
library(ipumsr)
library(plm)
library(Hmisc)
library(sandwich)
library(clubSandwich)


# ------------------------------------------------------------
# 2. Import source data
# ------------------------------------------------------------

# IPUMS USA microdata
# Place the IPUMS data files in a local "data" directory.
ddi <- read_ipums_ddi("data/usa_00001_ddt.xml")
data <- read_ipums_micro(ddi)

# State-level teacher salary and union data
book_data <- read.csv("data/book_dataset_needshhinc.csv")


# ------------------------------------------------------------
# 3. Filter IPUMS data to states included in the analysis
# ------------------------------------------------------------

states_of_interest <- c(
  13, 17, 21, 22, 25, 27,
  28, 34, 36, 45, 48, 55
)

data_sub <- data %>%
  filter(STATEFIP %in% states_of_interest)


# ------------------------------------------------------------
# 4. Construct state-level demographic measures
# ------------------------------------------------------------

state_race <- data_sub %>%
  group_by(YEAR, STATEFIP) %>%
  summarise(
    total_pop = sum(PERWT, na.rm = TRUE),
    
    pct_black =
      100 * sum(
        PERWT * (RACE == 2),
        na.rm = TRUE
      ) / total_pop,
    
    pct_asian =
      100 * sum(
        PERWT * (RACE %in% c(4, 5, 6)),
        na.rm = TRUE
      ) / total_pop,
    
    pct_nonhisp_white =
      100 * sum(
        PERWT * (RACE == 1 & HISPAN == 0),
        na.rm = TRUE
      ) / total_pop,
    
    .groups = "drop"
  )


# ------------------------------------------------------------
# 5. Calculate prime-age female labor-force participation
# ------------------------------------------------------------

# Prime-age defined as ages 25–54.
# GQ restrictions limit the measure to household observations.

female_lfp <- data_sub %>%
  filter(
    SEX == 2,
    AGE >= 25,
    AGE <= 54,
    GQ %in% c(1, 2)
  ) %>%
  group_by(YEAR, STATEFIP) %>%
  summarise(
    total_women = sum(PERWT, na.rm = TRUE),
    
    in_lf =
      sum(
        PERWT * (LABFORCE == 2),
        na.rm = TRUE
      ),
    
    female_lfp =
      100 * in_lf / total_women,
    
    .groups = "drop"
  )


# ------------------------------------------------------------
# 6. Calculate state unemployment rates
# ------------------------------------------------------------

unemp <- data_sub %>%
  group_by(YEAR, STATEFIP) %>%
  summarise(
    unemp =
      100 *
      sum(
        PERWT * (EMPSTAT == 2),
        na.rm = TRUE
      ) /
      sum(
        PERWT * (EMPSTAT %in% 1:2),
        na.rm = TRUE
      ),
    
    .groups = "drop"
  )


# ------------------------------------------------------------
# 7. Combine state-level demographic measures
# ------------------------------------------------------------

flfp_unemp_race_data <- state_race %>%
  left_join(
    female_lfp,
    by = c("YEAR", "STATEFIP")
  ) %>%
  left_join(
    unemp,
    by = c("YEAR", "STATEFIP")
  )


# ------------------------------------------------------------
# 8. Add state names
# ------------------------------------------------------------

state_lookup <- data.frame(
  STATEFIP = c(
    13, 17, 21, 22, 25, 27,
    28, 34, 36, 45, 48, 55
  ),
  
  state_name = c(
    "Georgia",
    "Illinois",
    "Kentucky",
    "Louisiana",
    "Massachusetts",
    "Minnesota",
    "Mississippi",
    "New Jersey",
    "New York",
    "South Carolina",
    "Texas",
    "Wisconsin"
  )
)

flfp_unemp_race_data <- flfp_unemp_race_data %>%
  left_join(
    state_lookup,
    by = "STATEFIP"
  )


# ------------------------------------------------------------
# 9. Prepare household income data
# ------------------------------------------------------------

# INCTOT = 9999999 is the IPUMS "not applicable" code (mostly
# children under 15); recode to 0 so it doesn't inflate
# household income totals.

data_sub <- data_sub %>%
  mutate(INCTOT = ifelse(INCTOT == 9999999, 0, as.numeric(INCTOT)))

# Aggregate individual income to the household level.
# SERIAL identifies households within the IPUMS data.

hh_data <- data_sub %>%
  group_by(
    YEAR,
    STATEFIP,
    SERIAL
  ) %>%
  summarise(
    hh_income = sum(
      INCTOT,
      na.rm = TRUE
    ),
    
    HHWT = first(HHWT),
    
    .groups = "drop"
  )


# ------------------------------------------------------------
# 10. Calculate weighted median household income
# ------------------------------------------------------------

weighted_median <- function(x, w) {
  Hmisc::wtd.quantile(
    x,
    weights = w,
    probs = 0.5,
    na.rm = TRUE
  )
}

med_hhinc_weighted <- hh_data %>%
  group_by(
    YEAR,
    STATEFIP
  ) %>%
  summarise(
    median_hhinc =
      weighted_median(
        hh_income,
        HHWT
      ),
    
    .groups = "drop"
  )


# ------------------------------------------------------------
# 11. Adjust household income for inflation
# ------------------------------------------------------------

# CPI values used to convert household income to constant
# 2018 dollars, matching the teacher salary measure.

cpi <- data.frame(
  YEAR = 2010:2020,
  
  CPI = c(
    218.056,
    224.939,
    229.594,
    232.957,
    236.736,
    237.017,
    240.007,
    245.120,
    251.107,
    255.657,
    258.811
  )
)

med_hhinc_real <- med_hhinc_weighted %>%
  left_join(
    cpi,
    by = "YEAR"
  ) %>%
  mutate(
    median_hhinc_2018usd =
      median_hhinc *
      (251.107 / CPI)
  )


# ------------------------------------------------------------
# 12. Clean teacher salary and union data
# ------------------------------------------------------------

book_data$state <- trimws(
  book_data$state
)

book_data <- book_data %>%
  filter(
    state != "United States"
  )


# ------------------------------------------------------------
# 13. Reshape teacher salary data
# ------------------------------------------------------------

# Convert year-specific salary columns into a long-format
# state-year dataset.

salary_long <- book_data %>%
  pivot_longer(
    cols = starts_with("sl_"),
    names_to = "year_label",
    values_to = "teacher_salary_raw"
  ) %>%
  mutate(
    # Remove currency symbols, commas, and other
    # non-numeric characters from salary values.
    teacher_salary =
      as.numeric(
        gsub(
          "[^0-9.]",
          "",
          as.character(
            teacher_salary_raw
          )
        )
      )
  )


# ------------------------------------------------------------
# 14. Convert salary year labels to numeric years
# ------------------------------------------------------------

year_lookup <- data.frame(
  year_label = c(
    "sl_1969_70",
    "sl_1979_80",
    "sl_1989_90",
    "sl_1999_20",
    "sl_2009_10",
    "sl_2012_13",
    "sl_2013_14",
    "sl_2014_15",
    "sl_2015_16",
    "sl_2016_17",
    "sl_2017_18",
    "sl_2018_19",
    "sl_2019_20"
  ),
  
  YEAR = c(
    1970,
    1980,
    1990,
    2000,
    2010,
    2013,
    2014,
    2015,
    2016,
    2017,
    2018,
    2019,
    2020
  )
)

salary_long <- salary_long %>%
  left_join(
    year_lookup,
    by = "year_label"
  )


# ------------------------------------------------------------
# 15. Construct final state-year analytical panel
# ------------------------------------------------------------

# Add household income measures to the demographic panel.

state_year_panel <- flfp_unemp_race_data %>%
  left_join(
    med_hhinc_real %>%
      select(
        YEAR,
        STATEFIP,
        median_hhinc_2018usd
      ),
    
    by = c(
      "YEAR",
      "STATEFIP"
    )
  )


# Add teacher salary and union measures.

final_state_year <- state_year_panel %>%
  left_join(
    salary_long %>%
      select(
        state,
        YEAR,
        teacher_salary,
        col_bargain_teacher,
        right_to_work,
        StatesWithTeacherUnions_PctOfPublicSchoolTeachersInUnion_2017to18,
        StatesWithTeacherUnions_UnionStrengthRank,
        StatesWithTeacherUnions_UnionStrengthTier
      ),
    
    by = c(
      "state_name" = "state",
      "YEAR" = "YEAR"
    )
  )


# ------------------------------------------------------------
# 16. Data quality checks
# ------------------------------------------------------------

# Check the number of observations and missing values
# for each state.

panel_check <- final_state_year %>%
  group_by(state_name) %>%
  summarise(
    observations = n(),
    
    missing_salary =
      sum(
        is.na(teacher_salary)
      ),
    
    missing_income =
      sum(
        is.na(median_hhinc_2018usd)
      ),
    
    .groups = "drop"
  )

print(panel_check)


# Confirm that each state-year combination is unique.

duplicate_check <- final_state_year %>%
  count(
    state_name,
    YEAR
  ) %>%
  filter(
    n > 1
  )

if (nrow(duplicate_check) > 0) {
  warning(
    "Duplicate state-year observations detected."
  )
}


# ------------------------------------------------------------
# 17. Create analytical variables
# ------------------------------------------------------------

final_state_year <- final_state_year %>%
  mutate(
    log_teacher_salary =
      log(teacher_salary)
  )


# ------------------------------------------------------------
# 18. Estimate regression models
# ------------------------------------------------------------

# Pooled ordinary least squares model.

ols_model <- lm(
  teacher_salary ~
    median_hhinc_2018usd +
    pct_black +
    pct_asian +
    female_lfp +
    unemp +
    right_to_work +
    StatesWithTeacherUnions_PctOfPublicSchoolTeachersInUnion_2017to18,
  
  data = final_state_year
)


# State fixed-effects model.

fe_model <- plm(
  teacher_salary ~
    median_hhinc_2018usd +
    pct_black +
    pct_asian +
    female_lfp +
    unemp,
  
  data = final_state_year,
  
  index = c(
    "STATEFIP",
    "YEAR"
  ),
  
  model = "within"
)


# Two-way fixed-effects model with state and year effects.

twfe_model <- plm(
  teacher_salary ~
    median_hhinc_2018usd +
    pct_black +
    pct_asian +
    female_lfp +
    unemp,
  
  data = final_state_year,
  
  index = c(
    "STATEFIP",
    "YEAR"
  ),
  
  model = "within",
  
  effect = "twoways"
)


# ------------------------------------------------------------
# 19. Estimate log-salary models
# ------------------------------------------------------------

log_ols_model <- lm(
  log_teacher_salary ~
    median_hhinc_2018usd +
    pct_black +
    pct_asian +
    female_lfp +
    unemp +
    right_to_work +
    StatesWithTeacherUnions_PctOfPublicSchoolTeachersInUnion_2017to18,
  
  data = final_state_year
)


log_fe_model <- plm(
  log_teacher_salary ~
    median_hhinc_2018usd +
    pct_black +
    pct_asian +
    female_lfp +
    unemp +
    right_to_work +
    StatesWithTeacherUnions_PctOfPublicSchoolTeachersInUnion_2017to18,
  
  data = final_state_year,
  
  index = c(
    "STATEFIP",
    "YEAR"
  ),
  
  model = "within"
)


log_twfe_model <- plm(
  log_teacher_salary ~
    median_hhinc_2018usd +
    pct_black +
    pct_asian +
    female_lfp +
    unemp +
    right_to_work +
    StatesWithTeacherUnions_PctOfPublicSchoolTeachersInUnion_2017to18,
  
  data = final_state_year,
  
  index = c(
    "STATEFIP",
    "YEAR"
  ),
  
  model = "within",
  
  effect = "twoways"
)


# ------------------------------------------------------------
# 20. Calculate cluster-robust standard errors
# ------------------------------------------------------------

# OLS models: state-clustered standard errors (HC1).

se_ols     <- sqrt(diag(vcovCL(ols_model,     cluster = ~STATEFIP, type = "HC1")))
se_log_ols <- sqrt(diag(vcovCL(log_ols_model, cluster = ~STATEFIP, type = "HC1")))

# Fixed-effects models:
# CR2 cluster-robust standard errors at the state level.

se_fe <- sqrt(
  diag(
    vcovCR(
      fe_model,
      cluster = final_state_year$STATEFIP,
      type = "CR2"
    )
  )
)

se_twfe <- sqrt(
  diag(
    vcovCR(
      twfe_model,
      cluster = final_state_year$STATEFIP,
      type = "CR2"
    )
  )
)

se_log_fe <- sqrt(
  diag(
    vcovCR(
      log_fe_model,
      cluster = final_state_year$STATEFIP,
      type = "CR2"
    )
  )
)

se_log_twfe <- sqrt(
  diag(
    vcovCR(
      log_twfe_model,
      cluster = final_state_year$STATEFIP,
      type = "CR2"
    )
  )
)


# ------------------------------------------------------------
# 21. Display primary model results (CR2 state-clustered SEs)
# ------------------------------------------------------------

coef_test(twfe_model, vcov = "CR2", cluster = final_state_year$STATEFIP)
